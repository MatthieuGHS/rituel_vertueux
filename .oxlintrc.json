{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "jsx-a11y",
    "typescript",
    "oxc",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "roles": [
          "region"
        ],
        "tags": []
      }
    ],
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "depth": 4
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ]
}
